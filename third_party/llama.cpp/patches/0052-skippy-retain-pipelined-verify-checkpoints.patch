From 74f123bce20e19b2767fb114f37100c82324daa8 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Fri, 24 Jul 2026 14:54:57 +1000
Subject: [PATCH 52/54] skippy: retain pipelined verify checkpoints

Assisted-by: goose
---
 src/skippy.cpp | 56 ++++++++++++++++++++++++++++----------------------
 1 file changed, 32 insertions(+), 24 deletions(-)

diff --git a/src/skippy.cpp b/src/skippy.cpp
index e10a935e3..2416f1fd3 100644
--- a/src/skippy.cpp
+++ b/src/skippy.cpp
@@ -162,7 +162,7 @@ struct skippy_session {
     llama_token mtp_pending_draft_token = -1;
     bool external_mtp_embeddings_available = false;
     std::vector<float> external_mtp_embeddings;
-    skippy_verify_checkpoint verify_checkpoint;
+    std::vector<skippy_verify_checkpoint> verify_checkpoints;
 };
 
 static thread_local skippy_session * g_skippy_external_decode_session = nullptr;
@@ -1565,7 +1565,6 @@ static enum skippy_status skippy_checkpoint_verify_window(
         const skippy_activation_desc * input_desc,
         const void * input_payload,
         skippy_error ** out_error) {
-    session->verify_checkpoint = {};
     llama_memory_t memory = session->ctx->get_memory();
     if (!skippy_memory_needs_verify_checkpoint(memory)) {
         return skippy_success(out_error);
@@ -1602,7 +1601,11 @@ static enum skippy_status skippy_checkpoint_verify_window(
         const uint8_t * bytes = static_cast<const uint8_t *>(input_payload);
         checkpoint.input_payload.assign(bytes, bytes + input_desc->payload_bytes);
     }
-    session->verify_checkpoint = std::move(checkpoint);
+    constexpr size_t max_verify_checkpoints = 8;
+    if (session->verify_checkpoints.size() >= max_verify_checkpoints) {
+        session->verify_checkpoints.erase(session->verify_checkpoints.begin());
+    }
+    session->verify_checkpoints.push_back(std::move(checkpoint));
     return skippy_success(out_error);
 }
 
@@ -4391,35 +4394,40 @@ static enum skippy_status skippy_restore_verify_prefix(
         bool * out_restored,
         skippy_error ** out_error) {
     *out_restored = false;
-    const skippy_verify_checkpoint & checkpoint = session->verify_checkpoint;
-    const uint64_t token_start = static_cast<uint64_t>(checkpoint.token_start);
-    const uint64_t token_end = token_start + checkpoint.token_count;
-    const uint64_t session_token_count = static_cast<uint64_t>(std::max(session->n_past, 0));
-    if (!checkpoint.valid || session_token_count != token_end ||
-            token_count < token_start || token_count >= token_end) {
+    const skippy_verify_checkpoint * checkpoint = nullptr;
+    for (auto it = session->verify_checkpoints.rbegin(); it != session->verify_checkpoints.rend(); ++it) {
+        const uint64_t token_start = static_cast<uint64_t>(it->token_start);
+        const uint64_t token_end = token_start + it->token_count;
+        if (it->valid && token_count >= token_start && token_count < token_end) {
+            checkpoint = &*it;
+            break;
+        }
+    }
+    if (checkpoint == nullptr) {
         return skippy_success(out_error);
     }
 
     const size_t read = llama_state_seq_set_data(
             session->ctx,
-            checkpoint.state.data(),
-            checkpoint.state.size(),
+            checkpoint->state.data(),
+            checkpoint->state.size(),
             session->seq_id);
-    if (read != checkpoint.state.size()) {
+    if (read != checkpoint->state.size()) {
         skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to restore verify-window sequence state");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
 
-    session->n_past = checkpoint.token_start;
+    const uint64_t token_start = static_cast<uint64_t>(checkpoint->token_start);
+    session->n_past = checkpoint->token_start;
     const size_t accepted_count = static_cast<size_t>(token_count - token_start);
     enum skippy_status status = SKIPPY_STATUS_OK;
-    if (accepted_count > 0 && checkpoint.has_activation_input) {
-        skippy_activation_desc input_desc = checkpoint.input_desc;
+    if (accepted_count > 0 && checkpoint->has_activation_input) {
+        skippy_activation_desc input_desc = checkpoint->input_desc;
         std::vector<uint8_t> input_payload = skippy_verify_prefix_activation_payload(
-                session, checkpoint, accepted_count);
+                session, *checkpoint, accepted_count);
         input_desc.token_count = static_cast<uint32_t>(accepted_count);
         input_desc.payload_bytes = input_payload.size();
-        const llama_token * token_ids = checkpoint.token_ids.empty() ? nullptr : checkpoint.token_ids.data();
+        const llama_token * token_ids = checkpoint->token_ids.empty() ? nullptr : checkpoint->token_ids.data();
         status = skippy_decode_activation_frame(
                 session,
                 &input_desc,
@@ -4433,7 +4441,7 @@ static enum skippy_status skippy_restore_verify_prefix(
     } else if (accepted_count > 0) {
         status = skippy_decode_tokens(
                 session,
-                checkpoint.token_ids.data(),
+                checkpoint->token_ids.data(),
                 accepted_count,
                 false,
                 out_error);
@@ -5222,7 +5230,7 @@ enum skippy_status skippy_session_set_position(
         session->signal_history.resize(static_cast<size_t>(n_past));
     }
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
     return skippy_success(out_error);
 }
 
@@ -5316,7 +5324,7 @@ enum skippy_status skippy_session_reset(
     session->signal_history.clear();
     skippy_clear_chat_sampling(session);
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
     session->ctx->synchronize();
     return skippy_success(out_error);
 }
@@ -6486,7 +6494,7 @@ static void skippy_update_session_state_after_import(
         session->signal_history.resize(static_cast<size_t>(session->n_past));
     }
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
 }
 
 enum skippy_status skippy_export_state(
@@ -6903,7 +6911,7 @@ enum skippy_status skippy_import_kv_page(
                     desc->token_start + desc->token_count,
                     static_cast<uint64_t>(std::numeric_limits<int32_t>::max()))));
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
     session->ctx->synchronize();
 
     return skippy_success(out_error);
@@ -6976,7 +6984,7 @@ enum skippy_status skippy_trim_session(
         session->signal_history.resize(static_cast<size_t>(token_count));
     }
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
     session->ctx->synchronize();
 
     return skippy_success(out_error);
@@ -7129,7 +7137,7 @@ enum skippy_status skippy_session_restore_prefix(
     }
     session->signal_history.clear();
     skippy_mtp_clear_session_state(session);
-    session->verify_checkpoint = {};
+    session->verify_checkpoints.clear();
     session->ctx->synchronize();
     return skippy_success(out_error);
 }
