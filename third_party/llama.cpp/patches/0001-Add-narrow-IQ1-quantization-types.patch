+static void quantize_row_iq1_narrow_impl(enum ggml_type type, const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t n,
+        const float * GGML_RESTRICT quant_weights,
+        float    * scales,
+        float    * weight,
