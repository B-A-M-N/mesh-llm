@@ -437,6 +444,44 @@ typedef struct {
 } block_iq1_m;
 static_assert(sizeof(block_iq1_m) == QK_K/8 + QK_K/16 + QK_K/32, "wrong iq1_m block size/padding");
 
+// Below IQ1_S: the same 8-dimensional ternary codebook with a NARROWER index.
+//
+// IQ1_S spends 1.3750 of its 1.5625 bpw on an 11-bit index into a 2048-entry grid, i.e. 88% of
+// the whole budget, so the index width is the only field worth shrinking. Every other field
+// keeps its IQ1_S meaning exactly: `d` is the fp16 super-block scale, the 3-bit sub-block code
+// gives `dl = d*(2*ls+1)`, and the sign bit selects `delta = +/-IQ1S_DELTA`. Dequantisation is
+// therefore identical to `dequantize_row_iq1_s` apart from how the index is reassembled.
+//
+// Per 32-element sub-block (QK_K/32 = 8 of them) each type must store 4 index-high fields, a
+// 3-bit scale and a sign bit. That is 12 / 8 / 4 bits for a 10 / 9 / 8 bit index, which packs
+// byte-exactly at 46 / 42 / 38 bytes per 256 weights.
+
+// 1.4375 bpw, 1024-entry grid, 10-bit index
+typedef struct {
+    ggml_half d;
+    uint8_t  qs[QK_K/8];      // index, low 8 bits
+    uint8_t  qh[QK_K/32];     // 4 x 2-bit index-high, one per group of 8
+    uint8_t  sc[QK_K/64];     // nibble per sub-block: bits0-2 scale, bit3 delta sign
+} block_iq1_xs;
+static_assert(sizeof(block_iq1_xs) == sizeof(ggml_half) + QK_K/8 + QK_K/32 + QK_K/64, "wrong iq1_xs block size/padding");
+
+// 1.3125 bpw, 512-entry grid, 9-bit index. The one that packs perfectly: the single index-high
+// bit per group leaves exactly room for the scale and sign in the same byte.
+typedef struct {
+    ggml_half d;
+    uint8_t  qs[QK_K/8];      // index, low 8 bits
+    uint8_t  qh[QK_K/32];     // bits0-3 index-high (one per group of 8), bits4-6 scale, bit7 delta sign
+} block_iq1_xxs;
+static_assert(sizeof(block_iq1_xxs) == sizeof(ggml_half) + QK_K/8 + QK_K/32, "wrong iq1_xxs block size/padding");
+
+// 1.1875 bpw, 256-entry grid, 8-bit index. The index fits in qs alone, so there is no qh at all.
+typedef struct {
+    ggml_half d;
+    uint8_t  qs[QK_K/8];      // the whole 8-bit index
+    uint8_t  sc[QK_K/64];     // nibble per sub-block: bits0-2 scale, bit3 delta sign
+} block_iq1_xxxs;
+static_assert(sizeof(block_iq1_xxxs) == sizeof(ggml_half) + QK_K/8 + QK_K/64, "wrong iq1_xxxs block size/padding");
+
 // Used by IQ1_M quants
 typedef union {
     ggml_half f16;
@@ -1131,6 +1176,9 @@ GGML_TABLE_END()
 #define NGRID_IQ1S 2048
 #define IQ1S_DELTA 0.125f
 #define IQ1M_DELTA 0.125f
