From 8b9868bb905fff3c3ef32a24fb7440df601e24bd Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Fri, 24 Jul 2026 19:02:35 +1000
Subject: [PATCH 53/54] skippy: filter Inkling stage memory by layer range

Assisted-by: goose
---
 include/skippy/common.h |  2 +-
 src/llama-model.cpp     | 11 +++++++++--
 src/skippy.cpp          |  4 ++--
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/include/skippy/common.h b/include/skippy/common.h
index 8c283047b..11f06bf3e 100644
--- a/include/skippy/common.h
+++ b/include/skippy/common.h
@@ -26,7 +26,7 @@ extern "C" {
 
 #define SKIPPY_ABI_VERSION_MAJOR 0
 #define SKIPPY_ABI_VERSION_MINOR 1
-#define SKIPPY_ABI_VERSION_PATCH 32
+#define SKIPPY_ABI_VERSION_PATCH 33
 
 enum skippy_feature {
     SKIPPY_FEATURE_RUNTIME_SLICE          = 1 << 0,
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 0944cb7c3..01320de64 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -6,6 +6,7 @@
 #include "llama-impl.h"
 #include "llama-mmap.h"
 #include "llama-cparams.h"
+#include "llama-graph.h"
 #include "llama-model-loader.h"
 
 #include "llama-kv-cache.h"
@@ -2116,8 +2117,14 @@ llama_memory_i * llama_model::create_memory(const llama_memory_params & params,
                             filter_attn = [&](uint32_t il) { return il >= hparams.n_layer(); };
                             filter_recr = [&](uint32_t il) { return il >= hparams.n_layer(); };
                         } else {
-                            filter_attn = [&](uint32_t il) { return il < hparams.n_layer(); };
-                            filter_recr = [&](uint32_t il) { return il < hparams.n_layer(); };
+                            const skippy_graph_filter stage_filter = skippy_graph_get_filter();
+                            filter_attn = [&, stage_filter](uint32_t il) {
+                                return il < hparams.n_layer() &&
+                                    (!stage_filter.enabled ||
+                                     (il >= static_cast<uint32_t>(stage_filter.layer_start) &&
+                                      il < static_cast<uint32_t>(stage_filter.layer_end)));
+                            };
+                            filter_recr = filter_attn;
                         }
                     } else if (arch == LLM_ARCH_NEMOTRON_H || arch == LLM_ARCH_NEMOTRON_H_MOE) {
                         filter_attn = [&](uint32_t il) {
diff --git a/src/skippy.cpp b/src/skippy.cpp
