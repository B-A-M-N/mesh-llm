--- a/src/skippy.cpp
+++ b/src/skippy.cpp
@@ -4437,6 +4437,7 @@ static enum skippy_status skippy_restore_verify_prefix(
                 0,
                 accepted_count,
                 false,
+                SKIPPY_GLM_DSA_PHASE_HINT_VERIFY,
                 out_error);
     } else if (accepted_count > 0) {
         status = skippy_decode_tokens(
@@ -4444,6 +4445,7 @@ static enum skippy_status skippy_restore_verify_prefix(
                 checkpoint->token_ids.data(),
                 accepted_count,
                 false,
+                SKIPPY_GLM_DSA_PHASE_HINT_VERIFY,
                 out_error);
     }
     if (status == SKIPPY_STATUS_OK) {
@@ -6972,8 +6974,6 @@ enum skippy_status skippy_trim_session(
             skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "runtime memory type is not supported for trim");
             return SKIPPY_STATUS_UNSUPPORTED;
         }
-    }
-        }
     }
     session->n_past = static_cast<int32_t>(token_count);
     if (session->token_history.size() > token_count) {
