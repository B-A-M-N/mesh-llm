     skippy_filter_scope filter_scope(config);
     llama_model * model = llama_model_load_from_file(path, params);
     if (model == nullptr) {
@@ -5155,17 +5313,16 @@ static enum skippy_status skippy_model_open_from_parts_impl(
             params.use_extra_bufts = false;
         }
     }
-    if (event_scope.is_enabled()) {
-        params.progress_callback = skippy_model_open_progress_callback;
-        params.progress_callback_user_data = &event_scope;
+    params.progress_callback = skippy_model_open_progress_callback;
+    params.progress_callback_user_data = &event_scope;
     }
 
     llama_backend_init();
     if (!ggml_backend_reg_count()) {
         ggml_backend_load_all();
     }
-    std::vector<ggml_backend_dev_t> selected_devices;
-    enum skippy_status device_status = skippy_apply_selected_backend_device(config, params, selected_devices, out_error);
+    ggml_backend_dev_t selected_dev = nullptr;
+    enum skippy_status device_status = skippy_apply_selected_backend_device(config, params, &selected_dev, out_error);
     if (device_status != SKIPPY_STATUS_OK) {
         if (out_error != nullptr && *out_error != nullptr) {
             event_scope.emit_failure(device_status, (*out_error)->message);
@@ -5174,6 +5331,14 @@ static enum skippy_status skippy_model_open_from_parts_impl(
         }
         return device_status;
     }
+
+    // Resolve semantic placement AFTER backend selection (selected_dev now authoritative).
+    skippy_resolved_model_placement resolved;
+    enum skippy_status placement_status = skippy_resolve_model_placement(config, selected_dev, params, resolved, out_error);
