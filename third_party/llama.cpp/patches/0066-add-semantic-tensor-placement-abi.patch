     skippy_filter_scope filter_scope(config);
     llama_model * model = llama_model_load_from_parts(paths, path_count, params);
     if (model == nullptr) {
@@ -5230,12 +5395,19 @@ enum skippy_status skippy_model_attach_mtp_draft_model(
     if (!ggml_backend_reg_count()) {
         ggml_backend_load_all();
     }
-    std::vector<ggml_backend_dev_t> selected_devices;
-    enum skippy_status device_status = skippy_apply_selected_backend_device(config, model_params, selected_devices, out_error);
+    ggml_backend_dev_t selected_dev = nullptr;
+    enum skippy_status device_status = skippy_apply_selected_backend_device(config, model_params, &selected_dev, out_error);
     if (device_status != SKIPPY_STATUS_OK) {
         return device_status;
     }
 
